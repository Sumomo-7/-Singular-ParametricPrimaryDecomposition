ring RingAll = 0, (x, y, z, s, t), (wp(2, 1, 3), dp);
ring RingVar = (0, s, t), (x, y, z), wp(2, 1, 3);

poly f = x2z + yz2 + y7 + sx3y + tx2y3;

ideal F = diff(f, x), diff(f, y), diff(f, z);

list Paras = s, t;
list Vars = x, y, z;

/////////////////////////////////////////////////
list L = paraprimdec(F, Paras, Vars, RingVar, RingAll);
L;
if_vanish(L);

exit;