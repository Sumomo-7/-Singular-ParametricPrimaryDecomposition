/////////////////////////////////////////////////
//                                             //
// Application 2: Singularity Resolution Check //
//                                             //
/////////////////////////////////////////////////
// We use the proposed parametric primary decomposition algorithm to determine the exceptional parameter values that cause the isolated singularity at the origin to vanish for a semi-weighted homogeneous hypersurface. A list of semi-weighted homogeneous polynomials(the defining polynomials of hypersurfaces) can be found in https://doi.org/10.1007/BF01390090, we compute the primary decomposition of part of them to demonstrate a possible application of our algorithm. 

proc equal_ideal(ideal I, ideal J){
        int i, j;
        if(size(I) != size(J)){
            return(0);
        }
        for(i=1; i<=size(I); i++){
            int flag = 1;
            for(j=1; j<=size(J); j++){
                if(I[i] == J[j]){
                    flag = 0;
                }
            }
            if(flag){
                return(0);
            }
        }
    return(1);
}

proc if_vanish(list L){
    int i, j, k;

    setring(RingVar);
    ideal M_var = maxideal(1);
    setring(RingAll);

    ideal M = imap(RingVar, M_var);
    for(i=1; i<=size(L); i++){
        list branch = L[i][1];
        int flag = 1;
        for(j=1; j<=size(branch); j++){
            ideal F = branch[j][2];

            if(equal_ideal(F, M)){
                flag = 0;
            }
        }
        if(flag){
            print("VANISH AT");
            print(i);
        }
    }
    print("END OF PROCEDURE if_vanish");
}

proc MultSingularity(list L){
    setring(RingVar);
    ideal M_var = maxideal(1);
    setring(RingAll);

    int i, j;
    for(i=1; i<=size(L); i++){
        print("BRANCH NO.");
        print(i);
        int flag = 1;
        list QPList = L[i][1];
        for(j=1; j<=size(QPList); j++){
            print("PRIMARY COMPONENT");
            ideal Q = QPList[j][1];
            Q;
            print("AND ITS ASSOCIATED PRIME");
            ideal P = QPList[j][2];
            P;
            ideal M = imap(RingVar, M_var);

            if(equal_ideal(P, M)){
                flag = 0;
                print("E");
                L[i][2];
                print("N");
                L[i][3];
                
                print("MULTIPLICITY OF SINGULARITY AT THE ORIGIN");
                ideal Q_p = groebner(para_leadmon(Q));

                setring(RingVar);
                ideal Q_var = groebner(imap(RingAll, Q));
                print(vdim(Q_var));
                setring(RingAll);
            }
        }
        if(flag){
            print("THE SINGULARITY SEEMS TO VANISH AT BRANCH NO.");
            print(i);
        }
    }
}
